{
 "absolute_value": 0,
 "align_labels_right": 0,
 "creation": "2026-08-02 23:10:03.716455",
 "custom_format": 1,
 "disabled": 0,
 "doc_type": "Sales Invoice",
 "docstatus": 0,
 "doctype": "Print Format",
 "font_size": 14,
 "html": "<style>\n  @page {\n    size: A4;\n    margin: 6mm;\n  }\n  .pharma-invoice {\n    font-family: Arial, Helvetica, sans-serif;\n    color: #000;\n    font-size: 11px;\n    line-height: 1.25;\n    background: #fff;\n    box-sizing: border-box;\n    width: 100%;\n  }\n\n  .header-top {\n    text-align: center;\n    border-bottom: 2px solid #000;\n    padding-bottom: 4px;\n    margin-bottom: 4px;\n  }\n\n  .header-top-title {\n    font-size: 16px;\n    font-weight: 900;\n    text-transform: uppercase;\n    color: #0c1b40;\n    letter-spacing: 1px;\n  }\n\n  .brand-section {\n    text-align: center;\n    margin: 4px 0 6px 0;\n  }\n\n  .brand-name {\n    font-family: 'Georgia', 'Times New Roman', serif;\n    font-size: 26px;\n    font-weight: 900;\n    font-style: italic;\n    color: #0c1b40;\n    letter-spacing: -0.5px;\n  }\n\n  .brand-subtitle {\n    font-size: 10.5px;\n    color: #002b66;\n    font-weight: bold;\n    margin-top: 2px;\n  }\n\n  .box-grid {\n    width: 100%;\n    border-collapse: collapse;\n    border: 1px solid #000;\n    margin-bottom: 4px;\n    table-layout: fixed;\n  }\n\n  .box-grid td {\n    border: 1px solid #000;\n    padding: 4px 6px;\n    vertical-align: top;\n    word-wrap: break-word;\n    overflow-wrap: break-word;\n  }\n\n  .items-grid {\n    width: 100%;\n    border-collapse: collapse;\n    border: 1px solid #000;\n    margin-bottom: 0px;\n    table-layout: fixed;\n  }\n\n  .items-grid th, .items-grid td {\n    border: 1px solid #000;\n    padding: 4px 2px;\n    font-size: 10px;\n    word-wrap: break-word;\n    overflow-wrap: break-word;\n  }\n\n  .items-grid th {\n    background-color: #fff;\n    color: #000;\n    font-weight: bold;\n    text-align: center;\n  }\n\n  .subtotal-banner {\n    background-color: #0c1b40;\n    color: #ffffff;\n    font-weight: bold;\n    font-size: 11px;\n    padding: 5px 8px;\n    border: 1px solid #000;\n    border-top: none;\n    display: flex;\n    justify-content: space-between;\n    align-items: center;\n    box-sizing: border-box;\n  }\n\n  .middle-summary-grid {\n    width: 100%;\n    border-collapse: collapse;\n    border: 1px solid #000;\n    border-top: none;\n    table-layout: fixed;\n  }\n\n  .middle-summary-grid td {\n    border: 1px solid #000;\n    padding: 6px;\n    vertical-align: top;\n    word-wrap: break-word;\n    overflow-wrap: break-word;\n  }\n\n  .net-amount-banner {\n    background-color: #0c1b40;\n    color: #ffffff;\n    font-weight: bold;\n    font-size: 11.5px;\n    padding: 5px 8px;\n    border: 1px solid #000;\n    border-top: none;\n    display: flex;\n    justify-content: space-between;\n    align-items: center;\n    box-sizing: border-box;\n  }\n\n  .footer-grid {\n    width: 100%;\n    border-collapse: collapse;\n    border: 1px solid #000;\n    border-top: none;\n    table-layout: fixed;\n  }\n\n  .footer-grid td {\n    border: 1px solid #000;\n    padding: 6px;\n    vertical-align: top;\n    word-wrap: break-word;\n    overflow-wrap: break-word;\n  }\n\n  .text-center { text-align: center !important; }\n  .text-right { text-align: right !important; }\n  .text-left { text-align: left !important; }\n\n  .qr-box-inner {\n    text-align: center;\n    padding: 2px;\n  }\n  .qr-box-inner img {\n    width: 75px;\n    height: 75px;\n    border: 1px solid #000;\n    padding: 2px;\n    background: #fff;\n  }\n</style>\n\n<div class=\"pharma-invoice\">\n  <!-- Header Top Bar -->\n  <div class=\"header-top\">\n    <div class=\"header-top-title\">TAX INVOICE</div>\n  </div>\n\n  <!-- Brand Name & Address -->\n  <div class=\"brand-section\">\n    <div class=\"brand-name\">{{ doc.company }}</div>\n    <div class=\"brand-subtitle\">\n      {% if doc.company_address_display %}\n        {{ doc.company_address_display | replace('<br>', ' | ') }}\n      {% else %}\n        Shop No.2, Basement, | Sunshine Commercial, Nalasopara(E) | Nalasopara | Maharashtra, State Code: 27 | PIN Code: 401209 | India\n      {% endif %}\n      {% if doc.company_gstin %}\n        | GSTIN: {{ doc.company_gstin }}\n      {% endif %}\n    </div>\n  </div>\n\n  <!-- Customer & Invoice Details Box -->\n  <table class=\"box-grid\">\n    <tr>\n      <td style=\"width: 58%;\">\n        <strong>To, &nbsp; {{ doc.customer_name or doc.customer }}</strong><br>\n        {% if doc.address_display %}\n          {{ doc.address_display }}<br>\n        {% endif %}\n        {% if doc.contact_mobile or doc.phone or doc.contact_phone %}\n          <strong>Ph No.:</strong> {{ doc.contact_mobile or doc.phone or doc.contact_phone }}\n        {% endif %}\n      </td>\n      <td style=\"width: 42%; font-size: 10.5px;\">\n        <table style=\"width: 100%; border: none;\">\n          <tr>\n            <td style=\"border:none; padding:1px;\"><strong>DL No.</strong></td>\n            <td style=\"border:none; padding:1px;\">: {{ doc.dl_no or 'DLdb3245, DL795 20.GBB' }}</td>\n          </tr>\n          <tr>\n            <td style=\"border:none; padding:1px;\"><strong>Invoice No.</strong></td>\n            <td style=\"border:none; padding:1px;\">: <strong>{{ doc.name }}</strong></td>\n          </tr>\n          <tr>\n            <td style=\"border:none; padding:1px;\"><strong>Date</strong></td>\n            <td style=\"border:none; padding:1px;\">: {{ doc.get_formatted(\"posting_date\") }}</td>\n          </tr>\n          <tr>\n            <td style=\"border:none; padding:1px;\"><strong>Due Date</strong></td>\n            <td style=\"border:none; padding:1px;\">: {{ doc.get_formatted(\"due_date\") if doc.due_date else '-' }}</td>\n          </tr>\n          <tr>\n            <td style=\"border:none; padding:1px;\"><strong>Invoice Type</strong></td>\n            <td style=\"border:none; padding:1px;\">: {{ 'Credit' if doc.is_pos == 0 else 'Cash' }}</td>\n          </tr>\n        </table>\n      </td>\n    </tr>\n  </table>\n\n  <!-- Items Table Grid (Fixed 100% Width) -->\n  <table class=\"items-grid\">\n    <thead>\n      <tr>\n        <th rowspan=\"2\" style=\"width: 3%;\">Sr.</th>\n        <th rowspan=\"2\" style=\"width: 7%;\">HSN</th>\n        <th rowspan=\"2\" style=\"width: 23.5%;\">Product Details & Services</th>\n        <th rowspan=\"2\" style=\"width: 8%;\">Batch No.</th>\n        <th rowspan=\"2\" style=\"width: 7%;\">Exp Dt</th>\n        <th rowspan=\"2\" style=\"width: 5%;\">Qty</th>\n        <th rowspan=\"2\" style=\"width: 5.5%;\">Unit</th>\n        <th rowspan=\"2\" style=\"width: 6%;\">Rate</th>\n        <th rowspan=\"2\" style=\"width: 7%;\">Taxable Amt</th>\n        <th colspan=\"2\" style=\"width: 8.5%;\">CGST</th>\n        <th colspan=\"2\" style=\"width: 8.5%;\">SGST</th>\n        <th colspan=\"2\" style=\"width: 8.5%;\">IGST</th>\n        <th rowspan=\"2\" style=\"width: 7.5%;\">Total Amount</th>\n      </tr>\n      <tr>\n        <th style=\"width: 3.5%;\">%</th>\n        <th style=\"width: 5%;\">Amt</th>\n        <th style=\"width: 3.5%;\">%</th>\n        <th style=\"width: 5%;\">Amt</th>\n        <th style=\"width: 3.5%;\">%</th>\n        <th style=\"width: 5%;\">Amt</th>\n      </tr>\n    </thead>\n    <tbody>\n      {% set total_qty = namespace(val=0) %}\n      {% for item in doc.items %}\n        {% set tb = get_item_tax_breakdown(item, doc) %}\n        {% set batch_exp = get_batch_expiry(item.batch_no) %}\n        {% set total_qty.val = total_qty.val + (item.qty or 0) %}\n        <tr>\n          <td class=\"text-center\">{{ loop.index }}</td>\n          <td class=\"text-center\">{{ item.gst_hsn_code or item.hsn_sac or '' }}</td>\n          <td class=\"text-left\"><strong>{{ item.item_name or item.item_code }}</strong></td>\n          <td class=\"text-center\">{{ item.batch_no or '' }}</td>\n          <td class=\"text-center\">{{ batch_exp or '' }}</td>\n          <td class=\"text-center\">{{ item.qty | int if item.qty == item.qty | int else item.qty }}</td>\n          <td class=\"text-center\">{{ item.stock_uom or item.uom or '' }}</td>\n          <td class=\"text-right\">{{ \"%.2f\"|format(item.rate or 0) }}</td>\n          <td class=\"text-right\">{{ \"%.2f\"|format(tb.taxable_amt) }}</td>\n          <td class=\"text-center\">{{ \"%.2f\"|format(tb.cgst_rate) if tb.cgst_rate else '0.00' }}</td>\n          <td class=\"text-right\">{{ \"%.2f\"|format(tb.cgst_amt) }}</td>\n          <td class=\"text-center\">{{ \"%.2f\"|format(tb.sgst_rate) if tb.sgst_rate else '0.00' }}</td>\n          <td class=\"text-right\">{{ \"%.2f\"|format(tb.sgst_amt) }}</td>\n          <td class=\"text-center\">{{ \"%.2f\"|format(tb.igst_rate) if tb.igst_rate else '0.00' }}</td>\n          <td class=\"text-right\">{{ \"%.2f\"|format(tb.igst_amt) }}</td>\n          <td class=\"text-right\"><strong>{{ \"%.2f\"|format(tb.total_amt) }}</strong></td>\n        </tr>\n      {% endfor %}\n    </tbody>\n  </table>\n\n  <!-- Sub Total Banner -->\n  <div class=\"subtotal-banner\">\n    <div>Sub Total</div>\n    <div>Total Qty: {{ total_qty.val | int if total_qty.val == total_qty.val | int else total_qty.val }}</div>\n    <div>Amt Before Tax : {{ doc.get_formatted(\"net_total\") }}</div>\n  </div>\n\n  <!-- Middle Summary Grid (Bank Details, UPI QR, Totals) -->\n  {% set bank_info = get_company_bank_details(doc) %}\n  <table class=\"middle-summary-grid\">\n    <tr>\n      <!-- Bank Details fetched from DB -->\n      <td style=\"width: 38%; font-size: 10px;\">\n        <strong>Bank Details :</strong><br>\n        {% if bank_info and bank_info.has_data %}\n          {% if bank_info.bank_name %}<strong>Bank:</strong> {{ bank_info.bank_name }}<br>{% endif %}\n          {% if bank_info.account_no %}<strong>Ac. No. :</strong> {{ bank_info.account_no }}<br>{% endif %}\n          {% if bank_info.ifsc_code %}<strong>IFSC Code :</strong> {{ bank_info.ifsc_code }}<br>{% endif %}\n        {% else %}\n          {% if doc.company_bank_account %}\n            {{ doc.company_bank_account }}<br>\n          {% else %}\n            State Bank of India<br>\n            <strong>Ac. No. :</strong> 30860782555<br>\n            <strong>IFSC Code :</strong> SBIN222ED1<br>\n          {% endif %}\n        {% endif %}\n        <div style=\"margin-top: 6px;\">\n          <strong>Terms & Conditions :</strong><br>\n          Subject to Jurisdiction<br>\n          Advance Payment before Delivery.\n        </div>\n      </td>\n\n      <!-- UPI Payment QR Code & Outstanding -->\n      <td style=\"width: 30%; font-size: 10px;\" class=\"text-center\">\n        {% set upi_url = doc.custom_upi_qr or (\"upi://pay?pa=exponit@upi&pn=\" ~ (doc.company | urlencode) ~ \"&am=\" ~ doc.grand_total ~ \"&cu=INR&tn=Invoice%20\" ~ doc.name) %}\n        {% set qr_image_data = get_upi_qr_data_url(upi_url) %}\n        <div class=\"qr-box-inner\">\n          <div style=\"font-weight: bold; color: #0c1b40; margin-bottom: 2px;\">Scan & Pay via UPI</div>\n          {% if qr_image_data %}\n            <img src=\"{{ qr_image_data }}\" alt=\"UPI QR\" />\n          {% endif %}\n          <div style=\"font-size: 8.5px; color: #444; margin-top: 2px;\">exponit@upi</div>\n        </div>\n        <div style=\"margin-top: 4px; border-top: 1px solid #777; padding-top: 2px;\">\n          <strong style=\"color: #0c1b40; font-size: 11px;\">Outstanding Amt</strong><br>\n          <span style=\"font-size: 12px; font-weight: bold;\">{{ doc.get_formatted(\"grand_total\") }}</span>\n        </div>\n      </td>\n\n      <!-- Totals Column -->\n      <td style=\"width: 32%; font-size: 10.5px;\">\n        <table style=\"width: 100%; border: none;\">\n          <tr>\n            <td style=\"border:none; padding: 3px 0;\">Discount</td>\n            <td style=\"border:none; padding: 3px 0;\" class=\"text-right\">: {{ doc.get_formatted(\"discount_amount\") if doc.discount_amount else '0.00' }}</td>\n          </tr>\n          <tr>\n            <td style=\"border:none; padding: 3px 0;\">CGST/IGST</td>\n            <td style=\"border:none; padding: 3px 0;\" class=\"text-right\">: {{ doc.get_formatted(\"total_taxes_and_charges\") if doc.total_taxes_and_charges else '0.00' }}</td>\n          </tr>\n          <tr>\n            <td style=\"border:none; padding: 3px 0;\">SGST</td>\n            <td style=\"border:none; padding: 3px 0;\" class=\"text-right\">: {{ \"%.2f\"|format((doc.total_taxes_and_charges or 0) / 2.0) }}</td>\n          </tr>\n        </table>\n      </td>\n    </tr>\n  </table>\n\n  <!-- Net Amount Banner -->\n  <div class=\"net-amount-banner\">\n    <div>Amt in Words : {{ doc.in_words or '' }}</div>\n    <div>Net Amount : {{ doc.get_formatted(\"grand_total\") }}</div>\n  </div>\n\n  <!-- Footer Grid (Terms, Signatures) -->\n  <table class=\"footer-grid\">\n    <tr>\n      <td style=\"width: 45%; font-size: 9px;\">\n        <strong>Terms and Conditions</strong><br>\n        Goods once sold are not returned or exchanged<br>\n        If bill is not paid within 10 days, interest will be charged @ 20% p.a.<br>\n        All dispute are subject to Jurisdiction only<br>\n        Your risk & responsibility ceases after delivery of goods to the carriers\n      </td>\n      <td style=\"width: 25%; font-size: 9.5px;\" class=\"text-center\">\n        <strong>Remarks :</strong><br><br><br>\n        Receiver Signature\n      </td>\n      <td style=\"width: 30%; font-size: 10.5px;\" class=\"text-center\">\n        <strong>For {{ doc.company }}</strong><br><br><br>\n        Auth. Signatory\n      </td>\n    </tr>\n  </table>\n\n  <!-- Bottom Message -->\n  <div class=\"text-center\" style=\"margin-top: 6px; font-weight: bold; font-size: 11px;\">\n    *** Thanks for doing Business with us ***\n  </div>\n</div>\n",
